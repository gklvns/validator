{
    "name": "gklvns/validator",
    "description": "Provides tools to validate values",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gklvns\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gklvns\\Validator\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Georgijs Kļaviņš",
            "email": "georgijs.klavins@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "infection/infection": "^0.34.2"
    },
    "scripts": {
        "php-cs-fixer": "./vendor/bin/php-cs-fixer fix",
        "phpstan": "./vendor/bin/phpstan analyse src tests --level=10",
        "phpunit": "php -dxdebug.mode=coverage ./vendor/bin/phpunit tests",
        "infection": [
            "@phpunit",
            "./vendor/bin/infection --skip-initial-tests --coverage=build"
        ],
        "test": [
            "@php-cs-fixer",
            "@phpstan",
            "@infection"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
